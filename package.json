{
  "name": "@rsnl-gg/library-validator",
  "version": "2026.9.1",
  "description": "Validate Helldivers 2 .patch mods against game data: unit format compatibility and Lua script detection",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rsnl-gg/library-validator.git"
  },
  "homepage": "https://github.com/rsnl-gg/library-validator#readme",
  "bugs": {
    "url": "https://github.com/rsnl-gg/library-validator/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true }); rmSync('dist-test', { recursive: true, force: true });\"",
    "build": "npm run clean && tsc",
    "check": "tsc -p tsconfig.test.json && node dist-test/test/integrity-check.js",
    "preversion": "npm run check && npm run build",
    "release": "node ./scripts/release.mjs",
    "release:github": "node ./scripts/release-github.mjs",
    "postversion": "git push --follow-tags && npm run release:github"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "lz4-lite": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
